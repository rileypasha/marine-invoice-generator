# Development Environment Configuration Example
# Copy this file to .env and update with your actual values

# Application Environment
NODE_ENV=development

# Server Configuration
PORT=3001

# Database Configuration - DEVELOPMENT DATABASE
# Use the development database clone to avoid affecting production data
# Production DB: marine_invoice_db (DO NOT USE FOR DEVELOPMENT)
# Development DB: mg_global_invoice_database_development
DATABASE_URL="postgresql://mg_global_invoice_database_development_user:dodvNaRzmFIi6mh2OJ3amxVJpRjqe9Ua@dpg-d3r8tmjuibrs73e57kf0-a.oregon-postgres.render.com/mg_global_invoice_database_development?connection_limit=10&pool_timeout=20&connect_timeout=10"

# Authentication & Security
SESSION_SECRET=dev-session-secret-change-in-production

# CORS Configuration
DEV_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:4173

# Geoapify API (for address autocomplete)
GEOAPIFY_API_KEY=your-api-key-here

# SendGrid Email Configuration
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@mginvoices.com

# Instructions:
# 1. For development work, use the development database (shown above)
# 2. For production deployments, use the production database
# 3. Never commit your actual .env file to git (it's gitignored for security)
# 4. When switching branches, update your .env DATABASE_URL accordingly
