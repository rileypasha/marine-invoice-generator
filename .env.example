# Environment Configuration for Marine Group Invoice System

# Application Environment (development, production, test)
NODE_ENV=production

# Server Configuration
PORT=10000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Authentication & Security
SESSION_SECRET=your-super-secure-session-secret-change-in-production

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=https://mginvoices.com,https://www.mginvoices.com

# Cookie Configuration
COOKIE_DOMAIN=.mginvoices.com

# Redis Configuration (optional - for session storage in production)
REDIS_URL=redis://localhost:6379

# API Configuration
API_BASE_URL=https://mginvoices.com

# Geoapify API (for address autocomplete)
GEOAPIFY_API_KEY=6291b90c7f8c4f888dda207c2f7f349a

# Development Only Settings
# DEV_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004