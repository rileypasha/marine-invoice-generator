{
  "name": "invoice-system",
  "version": "1.0.0",
  "description": "Auth-aware invoice management system with offline support",
  "main": "dist/server/app.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --watch server --ext ts --exec ts-node server/app.ts",
    "dev:client": "webpack serve --mode development",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "webpack --mode production",
    "start": "node dist/server/app.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "jest --testMatch='**/*.unit.test.ts' --coverage",
    "test:integration": "jest --testMatch='**/*.integration.test.ts' --runInBand",
    "test:e2e": "playwright test",
    "migrate:remove-drafts": "ts-node scripts/run-draft-migration.ts",
    "migrate:remove-drafts:apply": "ts-node scripts/run-draft-migration.ts --apply",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "connect-redis": "^7.1.0",
    "redis": "^4.6.5",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.7.0",
    "bcrypt": "^5.1.0",
    "winston": "^3.8.2",
    "compression": "^1.7.4",
    "body-parser": "^1.20.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "idb": "^7.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.4.2",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.17.7",
    "@types/cors": "^2.8.13",
    "@types/compression": "^1.7.2",
    "@types/bcrypt": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/supertest": "^2.0.12",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "typescript": "^5.1.6",
    "ts-node": "^10.9.1",
    "nodemon": "^2.0.22",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.1",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@playwright/test": "^1.35.1",
    "supertest": "^6.3.3",
    "webpack": "^5.88.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "ts-loader": "^9.4.4",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "html-webpack-plugin": "^5.5.3",
    "eslint": "^8.44.0",
    "@typescript-eslint/eslint-plugin": "^5.60.1",
    "@typescript-eslint/parser": "^5.60.1",
    "concurrently": "^8.2.0"
  }
}