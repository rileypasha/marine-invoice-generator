{
  "name": "marine-invoice-generator",
  "version": "1.0.2",
  "description": "Marine Group Invoice Request Generator",
  "main": "electron.js",
  "scripts": {
    "start": "electron .",
    "server": "node scripts/ensure-db-ready.js && node server/server.js",
    "server:dev": "NODE_ENV=development npm run server",
    "server:prod": "NODE_ENV=production npm run server",
    "dev": "webpack serve --mode development",
    "build": "node scripts/validate-schema.js --fix && webpack --mode production",
    "db:check": "node scripts/ensure-db-ready.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "node scripts/migrate-production-db.js",
    "db:reset": "prisma db push --force-reset",
    "test": "jest",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration --testTimeout=30000",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:regression": "playwright test test/e2e/invoice-save-regression.spec.js",
    "test:performance": "playwright test test/performance/ --workers=1",
    "test:visual": "node test/visual/run-tests.js",
    "test:visual:update": "jest --config=test/visual/jest.config.js --updateSnapshot",
    "test:critical": "npm run test:e2e:regression && npm run e2e:services && npm run e2e:bugs && npm run test:unit",
    "test:full": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:performance",
    "test:phase4": "playwright test --config=playwright.phase4.config.js",
    "test:phase4:quick": "node test/e2e/phase4-test-runner.js --health",
    "test:phase4:comprehensive": "node test/e2e/phase4-test-runner.js --comprehensive",
    "test:phase4:production": "playwright test test/e2e/phase4-production-navigation.spec.js --config=playwright.phase4.config.js",
    "test:phase4:local": "PHASE4_BASE_URL=http://localhost:3000 playwright test --config=playwright.phase4.config.js",
    "test:phase4:ui": "playwright test --config=playwright.phase4.config.js --ui",
    "test:phase4:debug": "DEBUG=pw:api playwright test --config=playwright.phase4.config.js --debug",
    "test:phase4:report": "playwright show-report test-results/phase4-playwright-report",
    "build:css": "tailwindcss -i ./src/styles/main.css -o ./dist/styles/main.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/main.css -o ./dist/styles/main.css --watch",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:all": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --mac --linux",
    "dist:clean": "rm -rf release/",
    "release": "npm run dist:clean && npm run build && npm run dist:all",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:reset": "prisma migrate deploy",
    "prisma:force-reset": "node prisma/force-reset.js",
    "dev:server": "node server/server.js",
    "start:prod": "npx prisma generate && node server/server.js",
    "ci:build": "npm run build && npm run build:css",
    "ci:test": "npm run test:critical",
    "ci:test:full": "npm run test:full",
    "ci:lint": "eslint src/ server/ --ext .js",
    "ci:security": "npm audit --audit-level=high",
    "ci:coverage": "jest --coverage --ci --watchAll=false",
    "e2e:ci": "playwright test --reporter=list",
    "e2e:trace": "playwright test --trace on-first-retry",
    "e2e:services": "playwright test test/e2e/services-add-item.spec.js --reporter=list",
    "e2e:services:trace": "playwright test test/e2e/services-add-item.spec.js --trace on-first-retry --video=retain-on-failure",
    "e2e:bugs": "playwright test test/e2e/services-tab-bugs.spec.js --reporter=list",
    "e2e:bugs:trace": "playwright test test/e2e/services-tab-bugs.spec.js --trace on-first-retry --video=retain-on-failure",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "e2e:regression:ci": "playwright test test/e2e/invoice-save-regression.spec.js --reporter=list --video=retain-on-failure",
    "quality:check": "npm run ci:lint && npm run ci:security && npm run ci:coverage",
    "quality:gate": "npm run test:critical && npm run quality:check",
    "docker:build": "docker build -t marine-invoice-generator .",
    "docker:dev": "docker-compose up -d",
    "docker:test": "docker-compose --profile testing up -d",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:logs": "docker-compose logs -f app",
    "docker:down": "docker-compose down -v",
    "monitor:start": "node scripts/monitor-edit-quality.js",
    "monitor:health": "curl -f http://localhost:3000/health || exit 1",
    "performance:load": "autocannon -c 10 -d 30 http://localhost:3000",
    "performance:lighthouse": "lighthouse http://localhost:3000 --output=json --quiet",
    "performance:save": "npm run test:performance",
    "security:scan": "npm audit && docker run --rm -v \"$(pwd):/app\" aquasec/trivy fs /app",
    "backup:db": "pg_dump $DATABASE_URL > backup-$(date +%Y%m%d-%H%M%S).sql",
    "deploy:staging": "echo 'Deploy to staging environment'",
    "deploy:production": "echo 'Deploy to production environment'",
    "deploy:check": "npm run quality:gate && npm run test:e2e:regression",
    "logs:app": "tail -f logs/app.log",
    "logs:error": "tail -f logs/error.log",
    "health:check": "node scripts/health-check.js",
    "precommit": "bash scripts/check-db-url.sh"
  },
  "keywords": [
    "invoice",
    "marine",
    "electron"
  ],
  "author": "Marine Group",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/jest": "^29.5.5",
    "@types/puppeteer": "^7.0.4",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "jest": "^29.7.0",
    "jest-image-snapshot": "^6.5.1",
    "jest-puppeteer": "^9.0.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "puppeteer": "^21.11.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.12",
    "webpack-dev-server": "^4.15.1"
  },
  "dependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@prisma/client": "^6.14.0",
    "axios": "^1.12.2",
    "babel-loader": "^9.1.3",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "connect-sqlite3": "^0.9.16",
    "copy-webpack-plugin": "^13.0.1",
    "cors": "^2.8.5",
    "css-loader": "^6.8.1",
    "csv-parser": "^3.2.0",
    "diff-match-patch": "^1.0.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "html-webpack-plugin": "^5.5.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.544.0",
    "multer": "^2.0.2",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "prisma": "^6.14.0",
    "react-dom": "^19.1.1",
    "style-loader": "^3.3.3",
    "tailwind-merge": "^3.3.1",
    "uuid": "^13.0.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "zod": "^4.1.5"
  },
  "build": {
    "appId": "com.marinegroup.invoice",
    "productName": "Marine Invoice Generator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "electron.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "Marine Group",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [],
      "extraFiles": []
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Marine Invoice Generator",
      "allowElevation": false,
      "installerIcon": null,
      "uninstallerIcon": null
    },
    "mac": {
      "category": "public.app-category.business",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "target": {
        "target": "dmg",
        "arch": [
          "x64"
        ]
      }
    },
    "dmg": {
      "title": "Marine Invoice Generator",
      "icon": null,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      "category": "Office"
    }
  }
}
