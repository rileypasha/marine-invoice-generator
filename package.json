{
  "name": "marine-invoice-generator",
  "version": "1.0.1",
  "description": "Marine Group Invoice Request Generator",
  "main": "electron.js",
  "scripts": {
    "start": "electron .",
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production && npm run prisma:migrate",
    "test": "jest",
    "test:unit": "jest test/unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "node test/visual/run-tests.js",
    "test:visual:update": "jest --config=test/visual/jest.config.js --updateSnapshot",
    "build:css": "tailwindcss -i ./src/styles/main.css -o ./dist/styles/main.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/main.css -o ./dist/styles/main.css --watch",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:all": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --mac --linux",
    "dist:clean": "rm -rf release/",
    "release": "npm run dist:clean && npm run build && npm run dist:all",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "dev:server": "node server/server.js",
    "start:prod": "node server/server.js"
  },
  "keywords": [
    "invoice",
    "marine",
    "electron"
  ],
  "author": "Marine Group",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/jest": "^29.5.5",
    "@types/puppeteer": "^7.0.4",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "jest": "^29.7.0",
    "jest-image-snapshot": "^6.5.1",
    "jest-puppeteer": "^9.0.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "puppeteer": "^21.11.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.12",
    "webpack-dev-server": "^4.15.1"
  },
  "dependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@prisma/client": "^6.14.0",
    "babel-loader": "^9.1.3",
    "compression": "^1.8.1",
    "connect-sqlite3": "^0.9.16",
    "copy-webpack-plugin": "^13.0.1",
    "cors": "^2.8.5",
    "css-loader": "^6.8.1",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "html-webpack-plugin": "^5.5.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "prisma": "^6.14.0",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "com.marinegroup.invoice",
    "productName": "Marine Invoice Generator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "electron.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "Marine Group",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [],
      "extraFiles": []
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Marine Invoice Generator",
      "allowElevation": false,
      "installerIcon": null,
      "uninstallerIcon": null
    },
    "mac": {
      "category": "public.app-category.business",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "target": {
        "target": "dmg",
        "arch": [
          "x64"
        ]
      }
    },
    "dmg": {
      "title": "Marine Invoice Generator",
      "icon": null,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      "category": "Office"
    }
  }
}
