{
  "name": "invoice-system",
  "version": "1.0.0",
  "description": "Auth-aware invoice management system with offline support",
  "main": "dist/server/app.js",
  "scripts": {
    "dev": "vite",
    "dev:server": "nodemon --watch server --ext ts --exec ts-node server/app.ts",
    "dev:client": "vite",
    "dev:auth": "node legacy-auth-server.js",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build:all": "npm run build:client && npm run build:server",
    "preview": "vite preview",
    "start": "node dist/server/app.js",
    "start:production": "NODE_ENV=production node dist/server/app.js",
    "start:auth": "node legacy-auth-server.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "jest --testMatch='**/*.unit.test.ts' --coverage",
    "test:integration": "jest --testMatch='**/*.integration.test.ts' --runInBand",
    "test:e2e": "playwright test",
    "migrate:remove-drafts": "ts-node scripts/run-draft-migration.ts",
    "migrate:remove-drafts:apply": "ts-node scripts/run-draft-migration.ts --apply",
    "migrate:deploy": "npx prisma migrate deploy",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@types/jspdf": "^1.3.3",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "bcrypt": "^5.1.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "connect-redis": "^7.1.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "express-session": "^1.18.2",
    "framer-motion": "^12.23.18",
    "helmet": "^7.0.0",
    "idb": "^7.1.1",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.544.0",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "pino": "^9.11.0",
    "prisma": "^6.16.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.1",
    "redis": "^4.6.5",
    "tailwind-merge": "^3.3.1",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.35.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.17.7",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.4.2",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^5.60.1",
    "@typescript-eslint/parser": "^5.60.1",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.0",
    "css-loader": "^6.8.1",
    "eslint": "^8.44.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.5.0",
    "nodemon": "^2.0.22",
    "postcss": "^8.5.6",
    "style-loader": "^3.3.3",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "vite": "^7.1.7",
    "webpack": "^5.88.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
