{
  "name": "marine-invoice-generator",
  "version": "1.0.0",
  "description": "Marine Group Invoice Request Generator",
  "main": "electron.js",
  "scripts": {
    "start": "electron .",
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "test": "jest",
    "test:e2e": "jest --config jest-e2e.config.js",
    "test:visual": "node test/visual/run-tests.js",
    "test:visual:update": "jest --config=test/visual/jest.config.js --updateSnapshot",
    "build:css": "tailwindcss -i ./src/styles/main.css -o ./dist/styles/main.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/main.css -o ./dist/styles/main.css --watch",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "keywords": [
    "invoice",
    "marine",
    "electron"
  ],
  "author": "Marine Group",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/jest": "^29.5.5",
    "@types/puppeteer": "^7.0.4",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "cssnano": "^7.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "express": "^5.1.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.7.0",
    "jest-image-snapshot": "^6.5.1",
    "jest-puppeteer": "^9.0.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "puppeteer": "^21.11.0",
    "style-loader": "^3.3.3",
    "tailwindcss": "^4.1.12",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1"
  },
  "build": {
    "appId": "com.marinegroup.invoice",
    "productName": "Marine Invoice Generator",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "publisherName": "Marine Group"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
