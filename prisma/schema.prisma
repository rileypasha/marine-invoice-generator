generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String?
  title         String
  status        String   @default("saved") // saved, archived, draft
  data          String   // JSON string of invoice data
  metadata      String?
  
  // User info
  userId        String?
  userName      String?
  userEmail     String?
  
  // Vessel info (extracted from data for quick filtering)
  vesselName    String?
  vesselWeight  Float?
  vesselBeam    Float?
  
  // Customer info (extracted from data for quick filtering)
  customerName  String?
  customerEmail String?
  customerPhone String?
  
  // Financial (extracted from data for dashboard display)
  subtotal      Float    @default(0)
  taxAmount     Float    @default(0)
  total         Float    @default(0)
  grossProfit   Float    @default(0)
  profitPercent Float    @default(0)
  
  // Additional metadata
  market        String?  // Market/City field
  notes         String?
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  savedAt       DateTime @default(now())
  submittedAt   DateTime?
  
  // Relations
  user          User?     @relation(fields: [userId], references: [id])
  submissions   InvoiceSubmission[]
  revisions     InvoiceRevision[]
  
  @@index([status, savedAt])
  @@index([userEmail])
  @@index([customerName])
}

model InvoiceSubmission {
  id          String   @id @default(uuid())
  invoiceId   String
  submittedBy String
  submittedAt DateTime @default(now())
  status      String   @default("pending")
  notes       String?
  
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
}

model InvoiceRevision {
  id          String   @id @default(uuid())
  invoiceId   String
  version     Int
  data        String   // JSON string of invoice data at this revision
  changedBy   String
  changedAt   DateTime @default(now())
  changeNotes String?
  
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String   @default("standard") // standard, master
  apiKey    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  invoices  Invoice[]
}