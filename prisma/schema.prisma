generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String?
  title         String
  status        String   @default("saved") // saved, archived, draft
  data          String   // JSON string of invoice data
  metadata      String?
  
  // User info
  userId        String?
  userName      String?
  userEmail     String?
  
  // Vessel info (extracted from data for quick filtering)
  vesselName    String?
  vesselWeight  Float?
  vesselBeam    Float?
  
  // Customer info (extracted from data for quick filtering)
  customerName  String?
  customerEmail String?
  customerPhone String?
  
  // Financial (extracted from data for dashboard display)
  subtotal      Float    @default(0)
  taxAmount     Float    @default(0)
  total         Float    @default(0)
  grossProfit   Float    @default(0)
  profitPercent Float    @default(0)
  
  // Additional metadata
  market        String?  // Market/City field
  notes         String?
  comments      String? // Comments from users and master
  
  // Change tracking
  // hasChanges    Boolean  @default(false) // Not in production DB yet
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  savedAt       DateTime @default(now())
  submittedAt   DateTime?
  
  // Relations
  user          User?     @relation(fields: [userId], references: [id])
  submissions   InvoiceSubmission[]
  revisions     InvoiceRevision[]
  changeViews   MasterChangeView[]
  
  @@index([status, savedAt])
  @@index([userEmail])
  @@index([customerName])
}

model InvoiceSubmission {
  id            String   @id @default(uuid())
  invoiceId     String
  submittedBy   String
  submittedAt   DateTime @default(now())
  status        String   @default("pending")
  notes         String?
  payloadJson   Json     // Normalized invoice snapshot at submission
  
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  
  @@unique([invoiceId]) // Only one submission baseline per invoice
}

model InvoiceRevision {
  id             String   @id @default(uuid())
  invoiceId      String
  revisionNumber Int
  actorEmail     String
  changeSummary  String?
  payloadJson    Json     // Full normalized state at this revision
  createdAt      DateTime @default(now())
  
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  changeViews    MasterChangeView[]
  
  @@index([invoiceId, createdAt(sort: Desc)])
}

model MasterChangeView {
  id              String   @id @default(uuid())
  invoiceId       String
  latestRevisionId String
  masterEmail     String
  seenAt          DateTime
  createdAt       DateTime @default(now())
  
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  revision        InvoiceRevision @relation(fields: [latestRevisionId], references: [id])
  
  @@unique([invoiceId, latestRevisionId, masterEmail])
  @@index([invoiceId])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String?  // Hashed password for authentication
  role      String   @default("standard") // standard, master
  apiKey    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  invoices  Invoice[]
}

model IdempotencyRecord {
  id         String   @id @default(uuid())
  key        String   @unique
  requestId  String
  response   Json
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  
  @@index([expiresAt])
}