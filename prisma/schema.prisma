generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id
  email     String    @unique
  name      String?
  role      String    @default("standard")
  apiKey    String?   @unique @map("apiKey")
  createdAt DateTime  @default(now()) @map("createdAt")
  updatedAt DateTime  @default(now()) @updatedAt @map("updatedAt")
  password  String?
  invoices  Invoice[]
  vessels   Vessel[]

  @@map("User")
}

model Invoice {
  id                String             @id
  invoiceNumber     String?            @map("invoiceNumber")
  title             String
  status            String             @default("saved")
  data              String
  metadata          String?
  userId            String?            @map("userId")
  userName          String?
  userEmail         String?
  vesselName        String?
  vesselWeight      Float?
  vesselBeam        Float?
  customerName      String?            @map("customerName")
  customerEmail     String?            @map("customerEmail")
  customerPhone     String?
  subtotal          Float              @default(0)
  taxAmount         Float              @default(0)
  total             Float              @default(0)
  grossProfit       Float              @default(0)
  profitPercent     Float              @default(0)
  market            String?
  notes             String?
  createdAt         DateTime           @default(now()) @map("createdAt")
  updatedAt         DateTime           @default(now()) @updatedAt @map("updatedAt")
  savedAt           DateTime           @default(now())
  submittedAt       DateTime?
  hasChanges        Boolean            @default(false)
  comments          String?
  hasUnreadChanges  Boolean            @default(false)
  lastMasterViewAt  DateTime?
  customerId        String?            @map("customerId")
  vesselId          String?            @map("vesselId")
  customer          Customer?          @relation(fields: [customerId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
  vessel            Vessel?            @relation(fields: [vesselId], references: [id])
  InvoiceRevision   InvoiceRevision[]
  InvoiceSubmission InvoiceSubmission?
  MasterChangeView  MasterChangeView[]

  @@index([customerName])
  @@index([status, savedAt])
  @@index([userEmail])
  @@index([vesselId])
  @@map("Invoice")
}

model Customer {
  id            String    @id
  display_name  String    @unique
  legal_name    String?
  email         String?
  phone         String?
  tax_id        String?
  address_line1 String?
  address_line2 String?
  city          String?
  state         String?
  postal_code   String?
  country       String?   @default("US")
  notes         String?
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime
  invoices      Invoice[]

  @@index([display_name])
  @@index([email])
  @@index([is_active, display_name])
  @@index([tax_id])
  @@map("Customer")
}

model Vessel {
  id                  String    @id
  userId              String    @map("userId")
  name                String
  registration_number String?
  mmsi                String?
  imo                 String?
  length_ft           Float?
  beam_ft             Float?
  draft_ft            Float?
  weight_tons         Float?
  home_port           String?
  notes               String?
  owner_name          String?
  owner_email         String?
  owner_phone         String?
  is_active           Boolean   @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime
  invoices            Invoice[]
  user                User      @relation(fields: [userId], references: [id])

  @@unique([userId, registration_number])
  @@index([userId, is_active])
  @@index([userId, name])
  @@index([userId, name, registration_number], map: "vessel_search_idx")
  @@map("Vessel")
}

model IdempotencyRecord {
  id        String   @id
  key       String   @unique
  requestId String
  response  Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model InvoiceRevision {
  id               String             @id
  invoiceId        String
  revisionNumber   Int
  payloadJson      Json
  actorEmail       String
  createdAt        DateTime           @default(now())
  changeSummary    String?
  Invoice          Invoice            @relation(fields: [invoiceId], references: [id])
  MasterChangeView MasterChangeView[]

  @@index([invoiceId, createdAt(sort: Desc)])
}

model InvoiceSubmission {
  id          String   @id
  invoiceId   String   @unique
  submittedBy String
  submittedAt DateTime @default(now())
  status      String   @default("pending")
  notes       String?
  payloadJson Json
  Invoice     Invoice  @relation(fields: [invoiceId], references: [id])
}

model MasterChangeView {
  id               String          @id
  invoiceId        String
  latestRevisionId String
  masterEmail      String
  seenAt           DateTime
  createdAt        DateTime        @default(now())
  Invoice          Invoice         @relation(fields: [invoiceId], references: [id])
  InvoiceRevision  InvoiceRevision @relation(fields: [latestRevisionId], references: [id])

  @@unique([invoiceId, latestRevisionId, masterEmail])
  @@index([invoiceId])
}
