generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id
  email            String            @unique
  name             String?
  role             String            @default("standard")
  apiKey           String?           @unique @map("apiKey")
  createdAt        DateTime          @default(now()) @map("createdAt")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updatedAt")
  password         String?
  avatarUrl        String?            @map("avatarUrl")
  // Email notification preferences (values: 'none', 'own', 'all')
  notifyOnNewInvoice     String        @default("none") @map("notifyOnNewInvoice")
  notifyOnChangeRequest  String        @default("none") @map("notifyOnChangeRequest")
  notifyOnApproval       String        @default("none") @map("notifyOnApproval")
  invoices         Invoice[]
  vessels          Vessel[]
  invoiceRevisions InvoiceRevision[]

  @@map("User")
}

model Invoice {
  id                String             @id
  invoiceNumber     String?            @map("invoiceNumber")
  title             String
  status            String             @default("requested")
  data              String
  metadata          String?
  userId            String?            @map("userId")
  userName          String?
  userEmail         String?
  modifiedByUserId  String?            @map("modifiedByUserId")
  modifiedByUserName String?           @map("modifiedByUserName")
  modifiedByUserEmail String?          @map("modifiedByUserEmail")
  vesselName        String?
  vesselWeight      Float?
  vesselBeam        Float?
  customerName      String?            @map("customerName")
  customerEmail     String?            @map("customerEmail")
  customerPhone     String?
  customerAddress   String?            @map("customerAddress")
  subtotal          Float              @default(0)
  taxAmount         Float              @default(0)
  total             Float              @default(0)
  grossProfit       Float              @default(0)
  profitPercent     Float              @default(0)
  market            String?
  notes             String?
  createdAt         DateTime           @default(now()) @map("createdAt")
  updatedAt         DateTime           @default(now()) @updatedAt @map("updatedAt")
  savedAt           DateTime           @default(now())
  submittedAt       DateTime?
  hasChanges        Boolean            @default(false)
  comments          String?
  hasUnreadChanges  Boolean            @default(false)
  lastMasterViewAt  DateTime?
  customerId        String?            @map("customerId")
  vesselId          String?            @map("vesselId")
  attachmentUrl     String?
  attachmentName    String?
  attachmentType    String?
  secondAttachmentUrl String?
  secondAttachmentName String?
  secondAttachmentType String?
  changeRequestSnapshot Json?             @map("changeRequestSnapshot")
  changeRequestDiff     Json?             @map("changeRequestDiff")
  changeRequestedAt     DateTime?         @map("changeRequestedAt")
  changeRequestedBy     String?           @map("changeRequestedBy")
  customer          Customer?          @relation(fields: [customerId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
  vessel            Vessel?            @relation(fields: [vesselId], references: [id])
  InvoiceRevision   InvoiceRevision[]
  InvoiceSubmission InvoiceSubmission?
  MasterChangeView  MasterChangeView[]
  InvoiceDiff       InvoiceDiff[]

  @@index([customerName])
  @@index([status, savedAt])
  @@index([userEmail])
  @@index([vesselId])
  @@index([status])
  @@map("Invoice")
}

model Customer {
  id            String    @id
  display_name  String    @unique
  legal_name    String?
  email         String?
  phone         String?
  tax_id        String?
  address_line1 String?
  address_line2 String?
  city          String?
  state         String?
  postal_code   String?
  country       String?   @default("US")
  notes         String?
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime
  invoices      Invoice[]

  @@index([display_name])
  @@index([email])
  @@index([is_active, display_name])
  @@index([tax_id])
  @@map("Customer")
}

model Vessel {
  id                  String    @id
  userId              String    @map("userId")
  name                String
  registration_number String?
  mmsi                String?
  imo                 String?
  length_ft           Float?
  beam_ft             Float?
  draft_ft            Float?
  weight_tons         Float?
  home_port           String?
  notes               String?
  owner_name          String?
  owner_email         String?
  owner_phone         String?
  is_active           Boolean   @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  invoices            Invoice[]
  user                User      @relation(fields: [userId], references: [id])

  @@unique([userId, registration_number])
  @@index([userId, is_active])
  @@index([userId, name])
  @@index([userId, name, registration_number], map: "vessel_search_idx")
  @@map("Vessel")
}

model IdempotencyRecord {
  id        String   @id
  key       String   @unique
  requestId String
  response  Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model InvoiceRevision {
  id               String             @id
  invoiceId        String
  revisionNumber   Int
  payloadJson      Json
  actorEmail       String
  actorId          String?            @map("actorId")
  actorName        String?            @map("actorName")
  ipAddress        String?            @map("ipAddress")
  userAgent        String?            @map("userAgent")
  createdAt        DateTime           @default(now())
  changeSummary    String?
  patch            Json?              // RFC-6902 JSON Patch array
  summaryJson      Json?              // Structured change summary
  changeCount      Int                @default(0)
  Invoice          Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  actor            User?              @relation(fields: [actorId], references: [id])
  MasterChangeView MasterChangeView[]
  diffsAsFrom      InvoiceDiff[]      @relation("FromRevision")
  diffsAsTo        InvoiceDiff[]      @relation("ToRevision")

  @@unique([invoiceId, revisionNumber])
  @@index([invoiceId, createdAt(sort: Desc)])
  @@index([actorId])
}

model InvoiceSubmission {
  id          String   @id
  invoiceId   String   @unique
  submittedBy String
  submittedAt DateTime @default(now())
  status      String   @default("pending")
  notes       String?
  payloadJson Json
  Invoice     Invoice  @relation(fields: [invoiceId], references: [id])
}

model MasterChangeView {
  id               String          @id
  invoiceId        String
  latestRevisionId String
  masterEmail      String
  seenAt           DateTime
  createdAt        DateTime        @default(now())
  Invoice          Invoice         @relation(fields: [invoiceId], references: [id])
  InvoiceRevision  InvoiceRevision @relation(fields: [latestRevisionId], references: [id])

  @@unique([invoiceId, latestRevisionId, masterEmail])
  @@index([invoiceId])
}

// RFC-6902 JSON Patch diffs between invoice revisions
model InvoiceDiff {
  id              String          @id
  invoiceId       String          @map("invoiceId")
  fromRevisionId  String          @map("fromRevisionId")
  toRevisionId    String          @map("toRevisionId")
  fromVersion     Int             // Denormalized for quick queries
  toVersion       Int             // Denormalized for quick queries
  patch           Json            // RFC-6902 JSON Patch array
  summary         Json            // Structured field-level change summary
  changeCount     Int             @default(0) // Number of operations in patch
  createdAt       DateTime        @default(now()) @map("createdAt")

  // Relations
  invoice         Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fromRevision    InvoiceRevision @relation("FromRevision", fields: [fromRevisionId], references: [id])
  toRevision      InvoiceRevision @relation("ToRevision", fields: [toRevisionId], references: [id])

  @@unique([invoiceId, fromVersion, toVersion])
  @@index([invoiceId, createdAt(sort: Desc)])
  @@index([toRevisionId])
  @@map("InvoiceDiff")
}
