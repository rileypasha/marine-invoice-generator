generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Invoice {
  id               String             @id @default(uuid())
  invoiceNumber    String?
  title            String
  status           String             @default("saved")
  data             String
  metadata         String?
  userId           String?
  userName         String?
  userEmail        String?
  vesselName       String?
  vesselWeight     Float?
  vesselBeam       Float?
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  customerId       String?
  vesselId         String?
  subtotal         Float              @default(0)
  taxAmount        Float              @default(0)
  total            Float              @default(0)
  grossProfit      Float              @default(0)
  profitPercent    Float              @default(0)
  market           String?
  notes            String?
  comments         String?
  hasChanges       Boolean            @default(false)
  hasUnreadChanges Boolean            @default(false)
  lastMasterViewAt DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now()) @updatedAt
  savedAt          DateTime           @default(now())
  submittedAt      DateTime?
  customer         Customer?          @relation(fields: [customerId], references: [id])
  vessel           Vessel?            @relation(fields: [vesselId], references: [id])
  user             User?              @relation(fields: [userId], references: [id])
  revisions        InvoiceRevision[]
  submissions      InvoiceSubmission?
  changeViews      MasterChangeView[]

  @@index([status, savedAt])
  @@index([userEmail])
  @@index([customerName])
  @@index([vesselId])
}

model InvoiceSubmission {
  id          String   @id @default(uuid())
  invoiceId   String   @unique
  submittedBy String
  submittedAt DateTime @default(now())
  status      String   @default("pending")
  notes       String?
  payloadJson Json
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
}

model InvoiceRevision {
  id             String             @id @default(uuid())
  invoiceId      String
  revisionNumber Int
  actorEmail     String
  changeSummary  String?
  payloadJson    Json
  createdAt      DateTime           @default(now())
  invoice        Invoice            @relation(fields: [invoiceId], references: [id])
  changeViews    MasterChangeView[]

  @@index([invoiceId, createdAt(sort: Desc)])
}

model MasterChangeView {
  id               String          @id @default(uuid())
  invoiceId        String
  latestRevisionId String
  masterEmail      String
  seenAt           DateTime
  createdAt        DateTime        @default(now())
  invoice          Invoice         @relation(fields: [invoiceId], references: [id])
  revision         InvoiceRevision @relation(fields: [latestRevisionId], references: [id])

  @@unique([invoiceId, latestRevisionId, masterEmail])
  @@index([invoiceId])
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  password  String?
  role      String    @default("standard")
  apiKey    String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  invoices  Invoice[]
  vessels   Vessel[]
}

model Customer {
  id            String    @id @default(uuid())
  display_name  String    @unique
  legal_name    String?
  email         String?
  phone         String?
  tax_id        String?
  address_line1 String?
  address_line2 String?
  city          String?
  state         String?
  postal_code   String?
  country       String?   @default("US")
  notes         String?
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  invoices      Invoice[]

  @@index([email])
  @@index([tax_id])
  @@index([display_name])
  @@index([is_active, display_name])
}

model Vessel {
  id                  String    @id @default(uuid())
  userId              String
  name                String
  registration_number String?
  mmsi                String?
  imo                 String?
  length_ft           Float?
  beam_ft             Float?
  draft_ft            Float?
  weight_tons         Float?
  home_port           String?
  notes               String?
  owner_name          String?
  owner_email         String?
  owner_phone         String?
  is_active           Boolean   @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id])
  invoices            Invoice[]

  @@unique([userId, registration_number], name: "unique_vessel_registration")
  @@index([userId, name])
  @@index([userId, is_active])
  @@index([userId, name, registration_number], name: "vessel_search_idx")
}

model IdempotencyRecord {
  id        String   @id @default(uuid())
  key       String   @unique
  requestId String
  response  Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}
