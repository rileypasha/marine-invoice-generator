/* Customers Page Styles - Modern Dark Theme with Zinc Palette */

.customers-page {
  padding: 2rem;
  max-width: 1400px;
  margin: 0 auto;
  color: rgb(244, 244, 245); /* zinc-100 */
}

/* Header */
.customers-page__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 2rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid rgb(63, 63, 70); /* zinc-700 */
}

.customers-page__title h1 {
  font-size: 2rem;
  font-weight: 700;
  color: rgb(244, 244, 245); /* zinc-100 */
  margin: 0 0 0.5rem 0;
}

.customers-page__subtitle {
  color: rgb(161, 161, 170); /* zinc-400 */
  margin: 0;
  font-size: 0.875rem;
}

.customers-page__actions {
  display: flex;
  gap: 1rem;
  align-items: center;
}

/* Search and Filters */
.customers-page__filters {
  margin-bottom: 1.5rem;
}

.search-bar {
  display: flex;
  gap: 1rem;
  align-items: center;
  max-width: 600px;
}

.search-bar__input {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
}

.search-bar__input svg {
  position: absolute;
  left: 1rem;
  z-index: 1;
  color: rgb(113, 113, 122); /* zinc-500 */
  pointer-events: none;
}

.search-input {
  width: 100%;
  padding: 0.75rem 1rem 0.75rem 3rem;
  background: rgb(39, 39, 42); /* zinc-800 */
  border: 1px solid rgb(63, 63, 70); /* zinc-700 */
  border-radius: 0.5rem;
  color: rgb(244, 244, 245); /* zinc-100 */
  font-size: 0.875rem;
  transition: all 0.2s ease-in-out;
  outline: none;
}

.search-input:focus {
  border-color: rgb(99, 102, 241); /* indigo-500 */
  box-shadow: 0 0 0 3px rgb(99, 102, 241, 0.1);
  background: rgb(24, 24, 27); /* zinc-900 */
}

.search-input::placeholder {
  color: rgb(113, 113, 122); /* zinc-500 */
}

/* Stats Bar */
.customers-page__stats {
  display: flex;
  gap: 2rem;
  margin-bottom: 1.5rem;
  padding: 1.5rem;
  background: rgb(39, 39, 42); /* zinc-800 */
  border: 1px solid rgb(63, 63, 70); /* zinc-700 */
  border-radius: 0.75rem;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.stat__value {
  font-size: 2rem;
  font-weight: 700;
  color: rgb(244, 244, 245); /* zinc-100 */
  line-height: 1;
}

.stat__value--success {
  color: rgb(34, 197, 94); /* green-500 */
}

.stat__value--warning {
  color: rgb(245, 158, 11); /* amber-500 */
}

.stat__value--error {
  color: rgb(239, 68, 68); /* red-500 */
}

.stat__label {
  font-size: 0.75rem;
  color: rgb(161, 161, 170); /* zinc-400 */
  margin-top: 0.25rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* Table */
.customers-page__table {
  background: rgb(39, 39, 42); /* zinc-800 */
  border: 1px solid rgb(63, 63, 70); /* zinc-700 */
  border-radius: 0.75rem;
  overflow: hidden;
  margin-bottom: 1.5rem;
}

.table-container {
  overflow-x: auto;
}

.customers-table {
  width: 100%;
  border-collapse: collapse;
}

.customers-table th {
  background: rgb(24, 24, 27); /* zinc-900 */
  padding: 1rem;
  text-align: left;
  font-weight: 600;
  font-size: 0.875rem;
  color: rgb(244, 244, 245); /* zinc-100 */
  border-bottom: 1px solid rgb(63, 63, 70); /* zinc-700 */
}

.customers-table td {
  padding: 1rem;
  border-bottom: 1px solid rgb(63, 63, 70); /* zinc-700 */
  vertical-align: top;
}

.customers-table tr:last-child td {
  border-bottom: none;
}

.customers-table tr:hover {
  background: rgb(63, 63, 70, 0.3);
}

/* Sort buttons */
.sort-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: none;
  border: none;
  color: inherit;
  font: inherit;
  font-weight: 600;
  cursor: pointer;
  padding: 0;
  transition: color 0.2s ease-in-out;
}

.sort-btn:hover {
  color: rgb(99, 102, 241); /* indigo-500 */
}

.sort-btn--active {
  color: rgb(99, 102, 241); /* indigo-500 */
}

.sort-btn svg {
  transition: transform 0.2s ease-in-out;
  flex-shrink: 0;
}

/* Table cells */
.customer-cell {
  min-width: 200px;
}

.customer-name {
  font-weight: 600;
  color: rgb(244, 244, 245); /* zinc-100 */
  margin-bottom: 0.25rem;
}

.customer-legal {
  font-size: 0.75rem;
  color: rgb(161, 161, 170); /* zinc-400 */
  font-style: italic;
}

.contact-cell {
  min-width: 180px;
}

.contact-email {
  color: rgb(99, 102, 241); /* indigo-500 */
  font-size: 0.875rem;
  margin-bottom: 0.25rem;
}

.contact-phone {
  color: rgb(34, 197, 94); /* green-500 */
  font-size: 0.875rem;
  font-family: 'SF Mono', 'Monaco', 'Cascadia Code', monospace;
}

.address-cell {
  min-width: 200px;
  color: rgb(161, 161, 170); /* zinc-400 */
  font-size: 0.875rem;
}

.date-cell {
  min-width: 100px;
  color: rgb(161, 161, 170); /* zinc-400 */
  font-size: 0.875rem;
  font-family: 'SF Mono', 'Monaco', 'Cascadia Code', monospace;
}

.actions-cell {
  min-width: 100px;
}

.actions-cell {
  display: flex;
  gap: 0.5rem;
}

/* Loading and Empty States */
.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rem 2rem;
  text-align: center;
}

.loading-spinner {
  width: 2rem;
  height: 2rem;
  border: 2px solid rgb(63, 63, 70); /* zinc-700 */
  border-top: 2px solid rgb(99, 102, 241); /* indigo-500 */
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 1rem;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.empty-state svg {
  color: rgb(113, 113, 122); /* zinc-500 */
  margin-bottom: 1rem;
}

.empty-state h3 {
  color: rgb(244, 244, 245); /* zinc-100 */
  font-size: 1.25rem;
  font-weight: 600;
  margin: 0 0 0.5rem 0;
}

.empty-state p {
  color: rgb(161, 161, 170); /* zinc-400 */
  margin: 0 0 1.5rem 0;
  font-size: 0.875rem;
}

/* Pagination */
.customers-page__pagination {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 1.5rem;
}

.pagination {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

.pagination__btn {
  padding: 0.5rem 0.75rem;
  background: rgb(39, 39, 42); /* zinc-800 */
  border: 1px solid rgb(63, 63, 70); /* zinc-700 */
  border-radius: 0.375rem;
  color: rgb(244, 244, 245); /* zinc-100 */
  font-size: 0.875rem;
  cursor: pointer;
  transition: all 0.2s ease-in-out;
  min-width: 2.5rem;
  text-align: center;
}

.pagination__btn:hover:not(:disabled) {
  background: rgb(63, 63, 70); /* zinc-700 */
  border-color: rgb(99, 102, 241); /* indigo-500 */
}

.pagination__btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.pagination__btn--active {
  background: rgb(99, 102, 241); /* indigo-500 */
  border-color: rgb(99, 102, 241); /* indigo-500 */
  color: white;
}

.pagination__info {
  color: rgb(161, 161, 170); /* zinc-400 */
  font-size: 0.875rem;
}

/* Modal Styles */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
}

.modal__backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgb(0, 0, 0, 0.8);
}

.modal__content {
  position: relative;
  background: rgb(24, 24, 27); /* zinc-900 */
  border: 1px solid rgb(63, 63, 70); /* zinc-700 */
  border-radius: 0.75rem;
  box-shadow: 0 25px 50px -12px rgb(0, 0, 0, 0.25);
  max-width: 600px;
  width: 100%;
  max-height: 90vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal__content--lg {
  max-width: 800px;
}

.modal__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem;
  border-bottom: 1px solid rgb(63, 63, 70); /* zinc-700 */
}

.modal__header h2 {
  font-size: 1.25rem;
  font-weight: 600;
  color: rgb(244, 244, 245); /* zinc-100 */
  margin: 0;
}

.modal__close {
  background: none;
  border: none;
  color: rgb(161, 161, 170); /* zinc-400 */
  cursor: pointer;
  padding: 0.5rem;
  border-radius: 0.375rem;
  transition: all 0.2s ease-in-out;
}

.modal__close:hover {
  color: rgb(244, 244, 245); /* zinc-100 */
  background: rgb(63, 63, 70); /* zinc-700 */
}

.modal__body {
  padding: 1.5rem;
  overflow-y: auto;
  flex: 1;
}

.modal__footer {
  display: flex;
  justify-content: flex-end;
  gap: 1rem;
  padding: 1.5rem;
  border-top: 1px solid rgb(63, 63, 70); /* zinc-700 */
  background: rgb(39, 39, 42); /* zinc-800 */
}

/* Form Styles */
.customer-form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.form-grid {
  display: grid;
  gap: 1rem;
}

.form-grid--2-col {
  grid-template-columns: 1fr 1fr;
}

.form-grid--3-col {
  grid-template-columns: 1fr 1fr 1fr;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.form-label {
  font-size: 0.875rem;
  font-weight: 500;
  color: rgb(244, 244, 245); /* zinc-100 */
}

.form-input,
.form-select,
.form-textarea {
  padding: 0.75rem;
  background: rgb(39, 39, 42); /* zinc-800 */
  border: 1px solid rgb(63, 63, 70); /* zinc-700 */
  border-radius: 0.5rem;
  color: rgb(244, 244, 245); /* zinc-100 */
  font-size: 0.875rem;
  transition: all 0.2s ease-in-out;
  outline: none;
}

.form-input:focus,
.form-select:focus,
.form-textarea:focus {
  border-color: rgb(99, 102, 241); /* indigo-500 */
  box-shadow: 0 0 0 3px rgb(99, 102, 241, 0.1);
  background: rgb(24, 24, 27); /* zinc-900 */
}

.form-input::placeholder,
.form-textarea::placeholder {
  color: rgb(113, 113, 122); /* zinc-500 */
}

.form-textarea {
  resize: vertical;
  min-height: 4rem;
}

/* Button Styles */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  border-radius: 0.5rem;
  border: 1px solid transparent;
  cursor: pointer;
  transition: all 0.2s ease-in-out;
  text-decoration: none;
  outline: none;
  justify-content: center;
}

.btn:focus-visible {
  box-shadow: 0 0 0 3px rgb(99, 102, 241, 0.2);
}

.btn--primary {
  background: rgb(99, 102, 241); /* indigo-500 */
  color: white;
  border-color: rgb(99, 102, 241); /* indigo-500 */
}

.btn--primary:hover {
  background: rgb(79, 70, 229); /* indigo-600 */
  border-color: rgb(79, 70, 229); /* indigo-600 */
}

.btn--outline {
  background: transparent;
  color: rgb(244, 244, 245); /* zinc-100 */
  border-color: rgb(63, 63, 70); /* zinc-700 */
}

.btn--outline:hover {
  background: rgb(63, 63, 70); /* zinc-700 */
}

.btn--ghost {
  background: transparent;
  color: rgb(161, 161, 170); /* zinc-400 */
  border-color: transparent;
}

.btn--ghost:hover {
  background: rgb(63, 63, 70); /* zinc-700 */
  color: rgb(244, 244, 245); /* zinc-100 */
}

.btn--sm {
  padding: 0.5rem 0.75rem;
  font-size: 0.75rem;
}

.btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Import Styles */
.import-steps {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.import-step {
  padding: 1.5rem;
  background: rgb(39, 39, 42); /* zinc-800 */
  border: 1px solid rgb(63, 63, 70); /* zinc-700 */
  border-radius: 0.5rem;
}

.import-step--active {
  border-color: rgb(99, 102, 241); /* indigo-500 */
  background: rgb(99, 102, 241, 0.05);
}

.import-step h3 {
  font-size: 1.125rem;
  font-weight: 600;
  color: rgb(244, 244, 245); /* zinc-100 */
  margin: 0 0 0.5rem 0;
}

.import-step p {
  color: rgb(161, 161, 170); /* zinc-400 */
  margin: 0 0 1rem 0;
  font-size: 0.875rem;
}

.file-upload {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.file-info {
  padding: 1rem;
  background: rgb(24, 24, 27); /* zinc-900 */
  border: 1px solid rgb(63, 63, 70); /* zinc-700 */
  border-radius: 0.5rem;
  font-size: 0.875rem;
  color: rgb(244, 244, 245); /* zinc-100 */
}

.import-results {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.import-stats {
  display: flex;
  gap: 2rem;
  justify-content: center;
}

.import-errors,
.import-duplicates {
  background: rgb(239, 68, 68, 0.1);
  border: 1px solid rgb(239, 68, 68, 0.2);
  border-radius: 0.5rem;
  padding: 1rem;
}

.import-errors h4,
.import-duplicates h4 {
  color: rgb(239, 68, 68); /* red-500 */
  font-size: 0.875rem;
  font-weight: 600;
  margin: 0 0 0.5rem 0;
}

.import-errors ul,
.import-duplicates ul {
  margin: 0;
  padding-left: 1.5rem;
  color: rgb(244, 244, 245); /* zinc-100 */
  font-size: 0.875rem;
}

.import-actions {
  display: flex;
  gap: 1rem;
  justify-content: center;
}

.import-error {
  color: rgb(239, 68, 68); /* red-500 */
  font-weight: 500;
  text-align: center;
  margin: 0;
}

/* Toast Notifications */
.toast {
  position: fixed;
  top: 1rem;
  right: 1rem;
  z-index: 1100;
  padding: 1rem 1.5rem;
  border-radius: 0.5rem;
  color: white;
  font-size: 0.875rem;
  font-weight: 500;
  max-width: 400px;
  transform: translateX(100%);
  transition: transform 0.3s ease-in-out;
}

.toast--show {
  transform: translateX(0);
}

.toast--success {
  background: rgb(34, 197, 94); /* green-500 */
}

.toast--error {
  background: rgb(239, 68, 68); /* red-500 */
}

.toast--info {
  background: rgb(99, 102, 241); /* indigo-500 */
}

/* Customer Selector Styles */
.customer-selector {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.customer-selector__search {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.form-label__helper {
  display: block;
  font-size: 0.75rem;
  color: rgb(161, 161, 170); /* zinc-400 */
  font-weight: 400;
  margin-top: 0.25rem;
}

.customer-selector__fields {
  padding: 1.5rem;
  background: rgb(39, 39, 42); /* zinc-800 */
  border: 1px solid rgb(63, 63, 70); /* zinc-700 */
  border-radius: 0.75rem;
}

.customer-selector__actions {
  display: flex;
  gap: 1rem;
  justify-content: flex-end;
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid rgb(63, 63, 70); /* zinc-700 */
}

.customer-selector__message {
  padding: 0.75rem 1rem;
  border-radius: 0.5rem;
  font-size: 0.875rem;
  margin-top: 1rem;
}

.customer-selector__message--success {
  background: rgb(34, 197, 94, 0.1);
  border: 1px solid rgb(34, 197, 94, 0.2);
  color: rgb(34, 197, 94); /* green-500 */
}

.customer-selector__message--error {
  background: rgb(239, 68, 68, 0.1);
  border: 1px solid rgb(239, 68, 68, 0.2);
  color: rgb(239, 68, 68); /* red-500 */
}

/* Responsive Design */
@media (max-width: 1024px) {
  .customers-page {
    padding: 1rem;
  }

  .customers-page__header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .customers-page__actions {
    align-self: stretch;
    justify-content: stretch;
  }

  .customers-page__actions .btn {
    flex: 1;
  }

  .customers-page__stats {
    flex-direction: column;
    gap: 1rem;
    text-align: left;
  }

  .stat {
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    text-align: left;
  }

  .form-grid--2-col,
  .form-grid--3-col {
    grid-template-columns: 1fr;
  }

  .modal__content {
    margin: 1rem;
    max-width: calc(100vw - 2rem);
  }

  .import-stats {
    flex-direction: column;
    gap: 1rem;
  }

  .customers-page__pagination {
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }
}

@media (max-width: 768px) {
  .search-bar {
    flex-direction: column;
    gap: 1rem;
  }

  .search-bar__input {
    width: 100%;
  }

  .table-container {
    font-size: 0.75rem;
  }

  .customers-table th,
  .customers-table td {
    padding: 0.75rem 0.5rem;
  }

  .pagination {
    flex-wrap: wrap;
    justify-content: center;
  }

  .modal__content {
    margin: 0.5rem;
    max-width: calc(100vw - 1rem);
    max-height: calc(100vh - 1rem);
  }

  .modal__header,
  .modal__body,
  .modal__footer {
    padding: 1rem;
  }
}