{
  "extends": "./tsconfig.json",
  "ts-node": {
    "files": true
  },
  "compilerOptions": {
    "outDir": "./dist/server",
    "rootDir": "./server",
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "types": ["node", "express"],
    "typeRoots": ["./node_modules/@types", "./server/types"]
  },
  "include": [
    "server/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src",
    "tests",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}